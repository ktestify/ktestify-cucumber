{
  "type": "record",
  "name": "OrderProcessed",
  "namespace": "io.github.ktestify.sample",
  "doc": "Processed order event emitted after business logic",
  "fields": [
    { "name": "orderId",     "type": "string", "doc": "Unique order identifier" },
    { "name": "amount",      "type": "double", "doc": "Order total amount" },
    { "name": "currency",    "type": "string", "doc": "ISO 4217 currency code" },
    { "name": "status",      "type": "string", "doc": "Final order status" },
    { "name": "processedAt", "type": ["null","long"], "default": null, "doc": "Epoch millis — excluded from comparisons" }
  ]
}

